# backend/.env.example — copy this file to backend/.env and fill in real
# values. backend/.env itself is gitignored (see .gitignore's **/.env
# line) and must NEVER be committed — this file holds placeholders only,
# safe to commit.
#
#   cp backend/.env.example backend/.env
#
# See SETUP.md for where each of these actually comes from.

# --- AWS base credentials -------------------------------------------------
# A base IAM user's long-term credentials. This user does NOT need
# CodeCommit or S3 permissions directly — it only needs sts:AssumeRole on
# the two role ARNs below, which is where the real read access lives.
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1

# --- CodeCommit (commits + pull requests) ---------------------------------
# The role AWS_ACCESS_KEY_ID above assumes (via STS) to get real read
# access to the CodeCommit repo. Create/find this in IAM > Roles — it must
# trust the base user above and grant codecommit:Get*/List* on the repo.
AWS_CODECOMMIT_ROLE_ARN=arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/REPLACE_WITH_ROLE_NAME
CODECOMMIT_REPO_NAME=REPLACE_WITH_YOUR_REPO_NAME
# No CODECOMMIT_BRANCH: codecommit_service.py walks every branch in the
# repo (ListBranches), not one hardcoded branch.

# --- Jira OAuth 2.0 (3LO) --------------------------------------------------
# Register an app at https://developer.atlassian.com/console/myapps/ with
# Jira API permissions: read:jira-work, read:project:jira, read:user:jira.
# client_id is also needed in vantage-frontend/.env as VITE_JIRA_CLIENT_ID
# (same value — it's meant to be public, safe to ship in the browser
# bundle). client_secret must ONLY ever live here — never in the frontend,
# never committed.
JIRA_CLIENT_ID=REPLACE_WITH_YOUR_ATLASSIAN_APP_CLIENT_ID
JIRA_CLIENT_SECRET=REPLACE_WITH_YOUR_ATLASSIAN_APP_CLIENT_SECRET

# --- SonarQube --------------------------------------------------------------
# Optional to get the rest of the app running — only the SonarQube panel
# needs these. Leave as placeholders and that panel honestly reports
# "not connected" (a real 503) rather than the app failing to start.
SONARQUBE_URL=https://your-sonarqube-instance.example.com
SONARQUBE_TOKEN=REPLACE_WITH_YOUR_SONARQUBE_USER_TOKEN

# --- Kiro usage reports (S3) -----------------------------------------------
# A separate AWS account/role from CodeCommit above — the role the base
# user assumes to read real per-developer Kiro usage CSVs.
AWS_KIRO_S3_ROLE_ARN=arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/REPLACE_WITH_ROLE_NAME
KIRO_USAGE_S3_BUCKET=REPLACE_WITH_YOUR_BUCKET_NAME
KIRO_USAGE_S3_PREFIX=REPLACE_WITH_YOUR_KEY_PREFIX/
