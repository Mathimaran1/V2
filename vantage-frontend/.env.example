# vantage-frontend/.env.example — copy this file to vantage-frontend/.env
# and fill in real values. vantage-frontend/.env itself is gitignored
# (see repo root .gitignore's **/.env line) and must NEVER be committed —
# this file holds placeholders only, safe to commit.
#
#   cp vantage-frontend/.env.example vantage-frontend/.env

# Same Atlassian app as backend/.env's JIRA_CLIENT_ID — this is the public
# half of that OAuth app, meant to ship in the browser bundle (hence the
# VITE_ prefix, which Vite exposes client-side). The matching
# JIRA_CLIENT_SECRET must NEVER go here — it lives only in backend/.env.
VITE_JIRA_CLIENT_ID=REPLACE_WITH_YOUR_ATLASSIAN_APP_CLIENT_ID

# Must be registered EXACTLY as a callback URL on that same Atlassian app
# (Atlassian rejects anything else — no wildcard support), and must match
# the port Vite actually runs on. vite.config.ts pins the dev server to
# port 5174 for exactly this reason — don't change one without the other.
VITE_JIRA_REDIRECT_URI=http://localhost:5174/auth/jira/callback
