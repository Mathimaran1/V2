#!/bin/bash
# Lightweight consent check — marker-file only, not the full interactive
# "type I agree" flow (that lives in pre-commit and stays there; a
# branch switch shouldn't be gated behind a prompt for something that
# doesn't itself write any tracking data). This just makes the gap
# visible instead of silent: post-checkout and pre-push were the two
# hooks that could run without ever touching consent (see TODO.md,
# 2026-08-26 "consent-in-every-hook" correction). Never blocks.
#
# Read from .kiro/consent-version — single source of truth shared with
# pre-commit and pre-push, replacing three separately hardcoded copies
# of the same string. See pre-commit's comment on this file for the
# full reasoning.
CONSENT_VERSION=$(cat .kiro/consent-version 2>/dev/null | tr -d '[:space:]')
CONSENT_FILE="$HOME/.kiro-tracking-consent-ack"
if ! grep -q "^$CONSENT_VERSION|" "$CONSENT_FILE" 2>/dev/null; then
  mkdir -p .kiro-tracking
  echo "hook_status=post-checkout-no-consent-marker ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .kiro-tracking/hook-health.log
fi

if [ "$3" = "1" ]; then
  echo "{}" > .kiro/current-ticket.json
  # Added 2026-09-02, root-cause fix: this only ever cleared
  # current-ticket.json, leaving .kiro/pending-ticket-check.json (a
  # typed_ticket deferred from post-commit's own terminal switch flow)
  # to survive a real branch switch untouched. Confirmed live: a stale
  # typed_ticket from an EARLIER branch's context outlived the switch,
  # then collided with a genuinely different, freshly-typed ticket ID
  # on the new branch — PRIORITY CHECK's own "runs on every message,
  # regardless of what it's about" instruction validated the stale
  # value and silently discarded the real one. Any pending sub-dialogue
  # state is tied to the branch context it was created in and has no
  # business surviving a switch to a different one — clear it here too,
  # same reasoning as current-ticket.json itself.
  rm -f .kiro/pending-ticket-check.json .kiro/pending-baseline-confirm.json
  echo "New branch — Kiro will ask for the ticket next time."
fi
