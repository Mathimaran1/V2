#!/bin/bash
# CASE B: deterministic, non-AI mid-session ticket-switch check. Runs
# right after every successful commit — this is the PRIMARY, reliable
# switch-detection mechanism (CASE C in the ask-ticket hook, AI-based
# and mid-conversation, is the softer secondary safety net for catching
# a switch before anything has been committed yet).
#
# Same episode_id generation scheme as CASE A/C, so every episode_id
# looks the same regardless of which case created it: 'ep_' + hex
# unix-timestamp + 3 random hex bytes.

# BUG FOUND AND FIXED 2026-08-27: this hook never checked
# $KIRO_AGENT_COMMIT — the same "TTY existing doesn't mean CASE A"
# mistake pre-commit already found and fixed in its own profile-click
# prompt (see pre-commit's 2026-08-26 comment on this). An agent's own
# tool-execution shell can have a real TTY attached, so the plain
# `{ : < /dev/tty; }` check below succeeded even for a
# `KIRO_AGENT_COMMIT=1` commit — real incident, confirmed: this
# question got dumped into a chat transcript as inert, unanswerable
# text after a commit the user had already approved in chat. Checked
# first, same priority order as pre-commit: agent-marked takes
# precedence over TTY presence.
#
# TTY availability check below: NOT `[ -t 0 ]`. Confirmed by testing
# (see TODO.md) that stdin is not a reliable signal here either way —
# a real human-typed `git commit` in an actual interactive terminal
# STILL shows `[ -t 0 ]` as false for this hook's stdin (same root
# cause pre-commit already hit and worked around). The only signal
# that was actually true for the human case and actually false for a
# script/agent running `git commit` as a subprocess with no
# controlling terminal at all is whether /dev/tty itself is openable —
# it fails outright (ENXIO) when there's no controlling terminal.
if [ -n "$KIRO_AGENT_COMMIT" ]; then
  # This commit was already approved in chat, but the SWITCH question
  # is a separate ask, about the ticket for whatever comes NEXT — it
  # was never answered and cannot be asked here either (same
  # dumped-into-transcript failure mode). Per
  # aidlc-git-conventions.md's CASE B chat-based counterpart, the
  # agent asks this directly in chat as its next message after a
  # KIRO_AGENT_COMMIT=1 commit succeeds — this hook does not, and must
  # not, attempt it.
  HAS_TTY=0
  mkdir -p .kiro-tracking
  echo "hook_status=post-commit-switch-check-skipped-agent-commit ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) commit=$(git rev-parse HEAD)" >> .kiro-tracking/hook-health.log
elif { : < /dev/tty; } 2>/dev/null; then
  HAS_TTY=1
else
  HAS_TTY=0
  mkdir -p .kiro-tracking
  echo "hook_status=post-commit-switch-check-skipped-no-tty ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) commit=$(git rev-parse HEAD)" >> .kiro-tracking/hook-health.log
fi

# 5-minute timeout: same reasoning as pre-commit's profile-click
# prompt — a TTY existing doesn't mean someone's actually watching it
# (Kiro's autopilot mode can leave a terminal technically open with
# nobody there), so without a timeout this blocks forever, the same
# hang the no-TTY branch above was built specifically to avoid. A
# timed-out read leaves SWITCH_ANSWER empty, which the check below
# already treats as "not switching" — the same safe default already
# used for an ambiguous reply — so no separate handling is needed
# there; this only adds the distinct log line, so a timeout is
# distinguishable from both "answered" and "no TTY at all" in
# hook-health.log.
if [ "$HAS_TTY" = "1" ]; then
  if ! read -t 300 -p "Working on a different ticket now? (y/n) (5 min timeout) " SWITCH_ANSWER < /dev/tty; then
    mkdir -p .kiro-tracking
    echo "hook_status=post-commit-switch-check-timeout ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) commit=$(git rev-parse HEAD)" >> .kiro-tracking/hook-health.log
  fi
fi

# Jira validation via a git-hook-level REST call — REMOVED 2026-08-27.
# It could only ever hit its own "no credential configured" branch
# (JIRA_BASE_URL/EMAIL/API_TOKEN are provisioned nowhere in this repo,
# confirmed by checking the environment directly), so it always
# returned success unvalidated — a real ticket and a made-up one were
# indistinguishable here (confirmed live: "ZZZZ-99999" was accepted
# exactly like a real ticket — see TODO.md). Kiro chat's own ask-ticket
# hook DOES have real, working Jira access via atlassian-rovo MCP, so
# validation is deferred there instead of pretended here — see below.

if [ "$HAS_TTY" = "1" ] && { [ "$SWITCH_ANSWER" = "y" ] || [ "$SWITCH_ANSWER" = "Y" ]; }; then
  read -p "New ticket ID (or 'none'): " NEW_TICKET < /dev/tty
  if [ -n "$NEW_TICKET" ] && [ "$NEW_TICKET" != "none" ]; then
    # Can't validate against Jira from a terminal hook (same gap as
    # pre-commit's manual-entry fallback — see its comments). Don't
    # switch yet: leave current-ticket.json on the OLD ticket, and hand
    # the typed value to Kiro chat's ask-ticket hook to check for real
    # via atlassian-rovo MCP on the user's next message.
    mkdir -p .kiro
    cat > .kiro/pending-ticket-check.json << INNER_EOF
{"typed_ticket": "$NEW_TICKET", "flagged_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
INNER_EOF
    echo "⚠️  Can't validate '$NEW_TICKET' against Jira from a terminal hook (no credential" >&2
    echo "   configured at this level). NOT switching yet — staying on the current ticket." >&2
    echo "   Tell Kiro about '$NEW_TICKET' in your next chat message and it'll validate via" >&2
    echo "   the real Jira connection and switch retroactively." >&2
  elif [ "$NEW_TICKET" = "none" ]; then
    # "none" isn't a claim about a real Jira ticket, so there's nothing
    # to validate — switch immediately, same as before.
    RESULT=$(python3 -c "
import sqlite3, json, os, time, secrets
con = sqlite3.connect(os.path.expanduser('~/.config/Kiro/User/globalStorage/state.vscdb'))
row = con.execute(\"SELECT value FROM ItemTable WHERE key='kiro.kiroAgent'\").fetchone()
val = row[0]
val = val.decode('utf-8') if isinstance(val, bytes) else val
usage = json.loads(val)['kiro.resourceNotifications.usageState']['usageBreakdowns'][0]['currentUsage']
print(usage)
print('ep_' + format(int(time.time()), 'x') + secrets.token_hex(3))
" 2>/dev/null)
    CREDITS_NOW=$(echo "$RESULT" | sed -n '1p')
    NEW_EPISODE=$(echo "$RESULT" | sed -n '2p')
    if [ -n "$CREDITS_NOW" ] && [ -n "$NEW_EPISODE" ]; then
      echo "{\"ticket_id\": \"$NEW_TICKET\", \"credits_at_ticket_start\": $CREDITS_NOW, \"episode_id\": \"$NEW_EPISODE\"}" > .kiro/current-ticket.json
      echo "✅ Switched to $NEW_TICKET — new episode $NEW_EPISODE, baseline $CREDITS_NOW credits." >&2
    else
      echo "⚠️  Could not read the current credit baseline — NOT switching, current-ticket.json left untouched." >&2
    fi
  else
    echo "No ticket entered — staying on the current ticket." >&2
  fi
fi
# "n", empty/default answer, or anything else: do nothing at all —
# current-ticket.json untouched, same episode continues.
