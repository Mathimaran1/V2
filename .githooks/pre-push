#!/bin/bash
# Lightweight consent check — marker-file only, not the full interactive
# "type I agree" flow (that lives in pre-commit and stays there). Runs
# before the SonarQube-disabled early exit below, on purpose — it must
# not become dead code once that block is removed and the real gate is
# re-enabled. Never blocks a push over missing consent, just logs it —
# see post-checkout for the same pattern and the reasoning in TODO.md,
# 2026-08-26 "consent-in-every-hook" correction.
#
# Read from .kiro/consent-version — single source of truth shared with
# pre-commit and post-checkout, replacing three separately hardcoded
# copies of the same string. See pre-commit's comment on this file for
# the full reasoning.
CONSENT_VERSION=$(cat .kiro/consent-version 2>/dev/null | tr -d '[:space:]')
CONSENT_FILE="$HOME/.kiro-tracking-consent-ack"
if ! grep -q "^$CONSENT_VERSION|" "$CONSENT_FILE" 2>/dev/null; then
  mkdir -p .kiro-tracking
  echo "hook_status=pre-push-no-consent-marker ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .kiro-tracking/hook-health.log
fi

# SonarQube gate temporarily disabled — no real SonarQube host/token configured
# yet, so this would just fail against placeholder values. Remove this block
# to re-enable once a real host is set up. Tracked in TODO.md at repo root —
# check it off there when this gets re-enabled for real, don't just delete
# this block quietly.
echo "" >&2
echo "⚠️⚠️⚠️  SONARQUBE QUALITY GATE IS DISABLED — this push is NOT being checked  ⚠️⚠️⚠️" >&2
echo "    See .githooks/pre-push (top of file) and TODO.md to re-enable." >&2
echo "" >&2
exit 0

# Mode is a single flag you control — start in "warn", switch to "block" once trusted
MODE=$(aws ssm get-parameter --name /kiro-tracking/sonarqube-gate-mode \
  --query 'Parameter.Value' --output text 2>/dev/null || echo "warn")

TICKET_ID=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.ticket_id // empty')

# Run the scan and ask SonarQube for the quality gate result
sonar-scanner -Dsonar.projectKey=YOUR_PROJECT \
  -Dsonar.host.url=https://your-sonarqube-host \
  -Dsonar.token="$SONARQUBE_TOKEN" > /tmp/sonar-scan.log 2>&1

GATE_STATUS=$(curl -s -u "$SONARQUBE_TOKEN": \
  "https://your-sonarqube-host/api/qualitygates/project_status?projectKey=YOUR_PROJECT" \
  | jq -r '.projectStatus.status')

# Record the result alongside the commit log, regardless of pass/fail
echo "{\"ticket_id\": \"$TICKET_ID\", \"gate_status\": \"$GATE_STATUS\", \"time\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" \
  > ".kiro-tracking/${TICKET_ID}-gate-$(date +%s).json"
aws s3 cp ".kiro-tracking/${TICKET_ID}-gate-"*.json "s3://your-tracking-bucket/tracking/" 2>/dev/null

if [ "$GATE_STATUS" != "OK" ]; then
  if [ "$MODE" = "block" ]; then
    echo "❌ SonarQube gate failed — push blocked. See /tmp/sonar-scan.log"
    exit 1
  else
    echo "⚠️ SonarQube gate failed — push allowed (warn mode). Please fix soon."
  fi
fi
