#!/bin/bash
# 0. Consent check — must happen before any tracking activity at all,
# before even gitleaks, since the point is "seen the notice before being
# tracked," not "seen it before being tracked, unless this particular
# commit happens to be clean." A per-USER marker (not per-repo), since
# consent is about the person, not any one project — versioned so a
# future change to what's tracked can force a re-prompt by bumping it.
#
# Read from .kiro/consent-version, not hardcoded here — this same
# string used to be duplicated identically across pre-commit, pre-push,
# and post-checkout (three separate places to edit, easy to miss one on
# a real bump, exactly as happened going v1→v2). Single source of
# truth now; bumping .kiro/consent-version alone forces a re-prompt
# everywhere. A missing/unreadable file yields an empty string, which
# never matches a real "v#|..." marker line below — fails open to
# re-asking, not open to silently skipping consent.
CONSENT_VERSION=$(cat .kiro/consent-version 2>/dev/null | tr -d '[:space:]')
CONSENT_FILE="$HOME/.kiro-tracking-consent-ack"
if ! grep -q "^$CONSENT_VERSION|" "$CONSENT_FILE" 2>/dev/null; then
  echo "" >&2
  echo "📋 This project tracks Kiro AI usage and credit spend per commit," >&2
  echo "   linked to your Jira ticket and git identity (see docs/runbook.md" >&2
  echo "   section 6 for exactly what's recorded, section 7 for who sees it)." >&2
  echo "" >&2
  echo "   Updated ($CONSENT_VERSION): credit/ticket data now rides as six" >&2
  echo "   Kiro-* trailers on the commit message itself (visible in git log" >&2
  echo "   and to anyone with read access to this repo), not a hidden" >&2
  echo "   .kiro-tracking/ file uploaded elsewhere. episode_id and" >&2
  echo "   mid-session ticket-switch detection were also added." >&2
  echo "" >&2
  # Read from the controlling terminal explicitly, not inherited stdin —
  # git does not guarantee a hook's stdin is the user's tty (confirmed by
  # testing: bash's own `read -p` silently skips printing the prompt and
  # returns instantly empty when stdin isn't a terminal, which is exactly
  # what happened here even though the surrounding `git commit` was typed
  # interactively). Without this, the prompt never appears and the commit
  # fails closed with no chance to actually answer it.
  read -p "Type 'I agree' to continue (required once per machine): " CONSENT_ANSWER < /dev/tty
  if [ "$CONSENT_ANSWER" != "I agree" ]; then
    echo "❌ Commit blocked — consent not given. Re-run and type 'I agree' exactly to proceed." >&2
    exit 1
  fi
  echo "$CONSENT_VERSION|$(date -u +%Y-%m-%dT%H:%M:%SZ)|$(git config user.email)" > "$CONSENT_FILE"
  echo "✅ Consent recorded at $CONSENT_FILE — won't ask again unless this notice changes." >&2
fi

# 1. Check for passwords/keys first — stops the commit if it finds any
gitleaks protect --staged || exit 1

# 2. Find the ticket ID: saved file, or block the commit entirely
TICKET_ID=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.ticket_id // empty')
# Always "kiro_session" now — `branch_name`, `manual_entry`, and `unset`
# were the only other values this ever took, and all three were removed
# entirely across 2026-08-27 (see the block below and TODO.md). Kept as
# a named field, not hardcoded inline, since `Kiro-Source` is still a
# real trailer field elsewhere in this file and in commit-msg.
SOURCE="kiro_session"

# Jira ticket-existence validation (EXISTENCE only, not assignment —
# already explicitly decided against, see TODO.md 2026-08-26). A saved
# ticket_id (SOURCE=kiro_session) is presumed already validated when it
# was answered through Kiro's own ask-ticket hook, which checks the
# real atlassian-rovo MCP connection — see
# aidlc-ask-for-ticket-if-missing.json — so it's not re-checked here.
#
# POLICY REVERSAL, 2026-08-27: "no ticket = track as 'none' and let the
# commit through" is REMOVED ENTIRELY. Every prior design in this
# section's history (branch-name guessing, the terminal manual-entry
# prompt, the null-flag pending-check deferral that replaced it) was
# some flavor of "let the commit through unticketed, sort it out
# later." This is the opposite decision: no ticket, no commit, full
# stop, no exceptions. `.kiro/pending-ticket-check.json`'s `typed_ticket:
# null` shape (the "nothing typed, ticket owed" flag) no longer exists
# either — there's nothing to defer once the commit itself is blocked
# outright. The shape-1 pending-check flow (a REAL typed value from
# post-commit's switch prompt, awaiting Jira validation) is unaffected
# and still deferred the same way — this reversal only removes the
# "commit anyway under none" escape hatch, not ticket validation itself.
#
# MIDDLE GROUND, same day: "none" was restored as a valid, EXPLICIT
# ticket_id value shortly after this reversal (see
# aidlc-ask-for-ticket-if-missing.json's CASE A1 and post-commit's
# switch flow) — but only as something a user actively chooses through
# Kiro chat or the switch prompt, written into current-ticket.json just
# like a real ticket. This block below needs no change for that: once
# "none" is chosen, TICKET_ID is the non-empty string "none", not
# empty, so it sails through here exactly like a real ticket would.
# This block only ever fires when NOTHING has been chosen at all yet.
if [ -z "$TICKET_ID" ]; then
  echo "❌ No ticket set for this work. Please open Kiro chat and tell it" >&2
  echo "   which ticket you're working on before committing. Every commit" >&2
  echo "   requires a real ticket — there are no exceptions." >&2
  exit 1
fi

# 2b. Ask-to-click gate — CASE A / CASE C of the three-way split
# documented in aidlc-git-conventions.md (CASE B, the chat-based
# counterpart, is a steering rule and lives entirely there — a hook
# cannot detect "a human is present in a chat conversation" at all).
#
# BUG FOUND AND FIXED 2026-08-26: `/dev/tty` openability alone cannot
# tell CASE A (human typing in a real terminal) apart from an agent
# running `git commit` through its own tool-execution mechanism — both
# can have a real TTY attached (agent tool-call shells are not
# guaranteed to be TTY-less the way a bare subprocess is; confirmed
# this actually happens). Result before this fix: an agent-run commit
# incorrectly took the CASE A branch, and the terminal prompt got
# dumped into the chat transcript as inert text — nobody was watching a
# real terminal to answer it. The TTY check cannot fix this from the
# hook's side alone; it needs the agent to self-identify explicitly,
# which is what $KIRO_AGENT_COMMIT does below. See the steering rule in
# aidlc-git-conventions.md: the agent asks in chat FIRST, waits for a
# real reply, and only then runs `KIRO_AGENT_COMMIT=1 git commit ...` —
# that env var is the one thing a hook genuinely can check, unlike
# guessing from TTY presence.
if [ -n "$KIRO_AGENT_COMMIT" ]; then
  # Permission was already handled in chat before this commit was run —
  # do NOT also prompt the terminal (there's likely no one watching it
  # even when one is attached, per the bug above).
  #
  # $KIRO_AGENT_COMMIT_UNCONFIRMED, added 2026-08-27: the chat-based
  # profile-click question has no real timeout (chat has no equivalent
  # of this file's own `read -t 300` below — Kiro cannot act after a
  # period of silence, only in response to a message), so the steering
  # doc's fallback is count-based instead: ask up to 3 times, and if
  # the 3rd reply still isn't a clear confirmation, proceed anyway but
  # set this second env var alongside $KIRO_AGENT_COMMIT so it's
  # distinguishable in this log from a commit that was actually
  # confirmed on the first try — the one piece of that behavioral rule
  # that IS reachable from here, unlike the ticket-switch question
  # (which resolves in chat with no hook invocation happening at that
  # moment to log anything into).
  mkdir -p .kiro-tracking
  if [ -n "$KIRO_AGENT_COMMIT_UNCONFIRMED" ]; then
    echo "hook_status=pre-commit-refresh-confirmed-via-chat-unconfirmed ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) branch=$(git branch --show-current)" >> .kiro-tracking/hook-health.log
  else
    echo "hook_status=pre-commit-refresh-confirmed-via-chat ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) branch=$(git branch --show-current)" >> .kiro-tracking/hook-health.log
  fi
elif { : < /dev/tty; } 2>/dev/null; then
  # CASE A (TTY present, e.g. a human typing `git commit` directly): ask
  # them to click their profile icon and refresh their credits BEFORE
  # this commit reads state.vscdb, so this exact commit can benefit from
  # a fresh number instead of pre-commit reading whatever's cached.
  #
  # 5-minute timeout: a TTY existing doesn't mean someone's actually
  # watching it — Kiro's autopilot mode can leave a terminal technically
  # open with nobody there. Without a timeout, `read -p` blocks forever
  # in that case, indistinguishable from CASE C's no-TTY fallback except
  # that it hangs instead of degrading. 5 minutes is long enough for
  # someone genuinely nearby to notice and respond, short enough not to
  # seriously stall an autopilot run that's actually unattended. Logged
  # distinctly from both "answered" (no log line at all) and "no TTY at
  # all" (the CASE C branch below), so hook-health.log can tell all
  # three apart.
  if read -t 300 -p "Please click your profile icon to refresh your credits, then press Enter to continue (5 min timeout): " _ < /dev/tty; then
    : # answered in time, continue normally
  else
    mkdir -p .kiro-tracking
    echo "hook_status=pre-commit-refresh-prompt-timeout ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) branch=$(git branch --show-current)" >> .kiro-tracking/hook-health.log
  fi
else
  # CASE C (no TTY at all, and not agent-marked — e.g. a fully headless
  # subprocess with nobody present): do NOT attempt to ask anything.
  # Same reasoning as post-commit's no-TTY ticket-switch fallback (see
  # CASE B there) — asking into nothing risks a hang, and `[ -t 0 ]` was
  # already tested and found to be the wrong signal (reads false even
  # for a genuine human-typed commit). No separate forced-low branch is
  # needed for confidence here: credit_confidence below already reads
  # state.vscdb's own internal timestamp as direct evidence, not a
  # guess — if nobody actually clicked, the cache stays stale and
  # confidence correctly comes out low on its own (verified by testing —
  # see TODO.md).
  mkdir -p .kiro-tracking
  echo "hook_status=pre-commit-refresh-prompt-skipped-no-tty ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) branch=$(git branch --show-current)" >> .kiro-tracking/hook-health.log
fi

# 3. Get credit numbers from the real local sources (no kiro-session-info —
#    that command doesn't exist; confirmed by inspecting the actual files):
#    - session id: most recently modified ~/.kiro/sessions/*/*/session.json
#    - credits:    ~/.config/Kiro/User/globalStorage/state.vscdb, key
#                   "kiro.kiroAgent" (JSON) -> "kiro.resourceNotifications
#                   .usageState".usageBreakdowns[0].currentUsage
# Also pull usageState's own internal "timestamp" field (line 2 of this
# command's output) — confirmed by testing (twice, reproduced — see
# TODO.md's 2026-08-26 dashboard-resync entry) that this timestamp is
# real evidence of when the cache was last actually refreshed: a human
# physically clicking their profile icon in the sidebar forces a real
# resync and moves this timestamp to "now", even when the command-based
# equivalent (kiro.accountDashboard.showDashboard, called programmatically)
# does not touch it at all. Used below to make credit_confidence a
# freshness check against real evidence, not just a time-since-baseline
# guess.
SESSION_FILE=$(ls -t "$HOME"/.kiro/sessions/*/*/session.json 2>/dev/null | head -1)
SESSION_ID=$(jq -r '.id // empty' "$SESSION_FILE" 2>/dev/null)

CREDITS_RESULT=$(python3 -c "
import sqlite3, json, sys
try:
    con = sqlite3.connect('$HOME/.config/Kiro/User/globalStorage/state.vscdb')
    row = con.execute(\"SELECT value FROM ItemTable WHERE key='kiro.kiroAgent'\").fetchone()
    val = row[0]
    if isinstance(val, bytes):
        val = val.decode('utf-8')
    usage_state = json.loads(val)['kiro.resourceNotifications.usageState']
    print(usage_state['usageBreakdowns'][0]['currentUsage'])
    print(usage_state.get('timestamp', ''))
except Exception:
    sys.exit(1)
" 2>/dev/null)
CREDITS_NOW=$(echo "$CREDITS_RESULT" | sed -n '1p')
CACHE_TIMESTAMP_MS=$(echo "$CREDITS_RESULT" | sed -n '2p')
CREDITS_START=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.credits_at_ticket_start // empty')
EPISODE_ID=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.episode_id // empty')

# 3d. Time tracking, added 2026-08-28 — same pattern as credits: a fixed
# start value (episode_started_at, written once when the episode began —
# see aidlc-ask-for-ticket-if-missing.json's CASE A1/C1 and post-commit's
# switch-to-none branch) plus a recalculated-per-commit current value
# (elapsed minutes, computed fresh here every commit, the same way
# CREDITS_DELTA above is recalculated fresh every commit against the
# fixed credits_at_ticket_start). `date -d` (GNU date) parses the ISO
# 8601 UTC string back into epoch seconds for the subtraction — this
# machine's `date` is GNU coreutils, confirmed by every other `date -u`
# call already in this file working correctly.
EPISODE_STARTED_AT=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.episode_started_at // empty')

# docs/kiro-confirmed-persistent-signal-proposal.md, added 2026-09-02 —
# same "read from current-ticket.json, empty means not-yet-computed"
# pattern as every other optional field above, computed once by
# ticket-gate-fastpath.sh. GAP_SECONDS is a number, safe with the
# usual `// empty` (jq's `//` only treats `false`/`null` as falsy, not
# 0). CONFIRMED is a real boolean and needs an explicit null-check
# instead — caught live in this build's own end-to-end test:
# `false // empty` evaluates to `empty` in jq (false counts as falsy
# for the alternative operator, same as null), which silently
# collapsed the one value this whole feature exists to surface
# reliably into a false "n/a". Exactly the class of bug the existing
# CREDITS_DELTA "null"-literal convention below was already built to
# avoid — missed it here on the first pass, fixed after the real test
# caught it, not assumed correct.
ASK_CONFIRMED_GAP_SECONDS=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.ask_confirmed_gap_seconds // empty')
ASK_CONFIRMED=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r 'if .ask_confirmed == null then "" else (.ask_confirmed | tostring) end')

# docs/jira-unavailable-hard-stop-proposal.md, added 2026-09-04 (Bug 4) —
# same "read from current-ticket.json, empty means not-yet-set (a
# baseline from before this field existed)" pattern as every other
# optional field above. Unlike ask_confirmed this is a plain string
# ('validated' / 'skipped_transient' / 'none'), not a boolean, so the
# jq //empty collapse bug that hit ASK_CONFIRMED doesn't apply here —
# no falsy string value is a valid jira_validation_status.
JIRA_VALIDATION_STATUS=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r '.jira_validation_status // empty')

# docs/cloudid-guess-detectability-proposal.md, added 2026-09-04 (Bug 2)
# — same shape as JIRA_VALIDATION_STATUS just above, but this one IS a
# real boolean in current-ticket.json (True/False, written by the
# bundled python baseline-write command), so it needs the same explicit
# null-check ASK_CONFIRMED already uses, not a plain `// empty` (which
# would collapse a real `false` the same way the jq bug caught earlier
# this project did for ask_confirmed).
CLOUD_ID_CONFIRMED=$(cat .kiro/current-ticket.json 2>/dev/null | jq -r 'if .cloud_id_confirmed == null then "" else (.cloud_id_confirmed | tostring) end')

ELAPSED_MINUTES="null"
if [ -n "$EPISODE_STARTED_AT" ]; then
  EPISODE_START_EPOCH=$(date -u -d "$EPISODE_STARTED_AT" +%s 2>/dev/null)
  if [ -n "$EPISODE_START_EPOCH" ]; then
    ELAPSED_MINUTES=$(awk -v now="$(date +%s)" -v start="$EPISODE_START_EPOCH" 'BEGIN{printf "%.2f", (now-start)/60}')
  fi
fi
# A missing or unparseable episode_started_at (e.g. a current-ticket.json
# baseline set before this field existed) is expected, not an error —
# same "null" convention CREDITS_DELTA already uses above, resolved to
# "n/a" by commit-msg the same way.

# Credits are decimals (e.g. 229.72) — bash's $(( )) only does integers and
# would silently truncate/break here, so use awk for the subtraction instead.
CREDITS_DELTA="null"
if [ -n "$CREDITS_NOW" ] && [ -n "$CREDITS_START" ]; then
  CREDITS_DELTA=$(awk -v now="$CREDITS_NOW" -v start="$CREDITS_START" 'BEGIN{printf "%.4f", now-start}')
fi

# 3b. Confidence flag: the usage cache backing CREDITS_NOW is periodically
# synced, not live (confirmed by testing — see TODO.md), so a commit made
# soon after the baseline was set can read a stale number and show 0.0000
# even when real work happened. We don't have an exact, confirmed refresh
# interval (Kiro's dashboard docs say ~5 min, but our own observed lag once
# ran to ~30 min, so treat 5 min as a floor, not a guarantee) — so flag low
# confidence whenever EITHER signal is present, erring toward under- rather
# than over-claiming precision:
#   - less than 5 min has passed since current-ticket.json's baseline was
#     set (using the file's own mtime as a free proxy — nothing else writes
#     to it besides the ask-ticket hook and post-checkout's reset)
#   - the delta computed out to exactly 0, which is exactly the lag symptom
# credits_used_so_far being cumulative-since-baseline (not per-commit —
# see the max-not-sum note in docs/runbook.md) means a low-confidence read
# here is always superseded by a later high-confidence one on this ticket.
CREDIT_CONFIDENCE="high"
if [ "$CREDITS_DELTA" = "null" ]; then
  CREDIT_CONFIDENCE="low"
elif [ -f .kiro/current-ticket.json ]; then
  BASELINE_SET_AT=$(stat -c %Y .kiro/current-ticket.json 2>/dev/null || echo 0)
  NOW_EPOCH=$(date +%s)
  ELAPSED=$((NOW_EPOCH - BASELINE_SET_AT))
  if [ "$ELAPSED" -lt 300 ] || [ "$CREDITS_DELTA" = "0.0000" ]; then
    CREDIT_CONFIDENCE="low"
  fi

  # 3c. Cache-freshness override: elapsed-since-baseline is a GUESS about
  # staleness; usageState's own internal timestamp is actual EVIDENCE of
  # when the cache was last really refreshed (see the comment above the
  # python read). Confirmed by testing, twice reproduced (TODO.md,
  # 2026-08-26): a dev physically clicking their profile icon in the
  # sidebar moves this timestamp to "now" — that's a real, testable
  # signal, even though nothing here can trigger it automatically (the
  # command-based equivalent does NOT move it).
  # This overrides the elapsed-since-baseline guess at both extremes:
  #   - cache is under 2 min old  -> HIGH, regardless of how long the
  #     ticket's been open: the dev likely just clicked their profile
  #     and CREDITS_NOW reflects a genuinely fresh read.
  #   - cache is over 10 min old  -> LOW, regardless of how long the
  #     ticket's been open: nothing has refreshed the cache recently,
  #     so a large elapsed time proves nothing about freshness.
  # Between 2 and 10 minutes old, neither extreme applies, so the
  # elapsed-since-baseline heuristic above stands as the fallback.
  if [ -n "$CACHE_TIMESTAMP_MS" ]; then
    CACHE_AGE_SECONDS=$(awk -v ts="$CACHE_TIMESTAMP_MS" -v now="$NOW_EPOCH" 'BEGIN{printf "%d", now - (ts/1000)}')
    if [ "$CACHE_AGE_SECONDS" -lt 120 ]; then
      CREDIT_CONFIDENCE="high"
    elif [ "$CACHE_AGE_SECONDS" -gt 600 ]; then
      CREDIT_CONFIDENCE="low"
    fi
  fi
fi

# JSON-quote the session id, or fall back to null. NOTE: the old
# ${VAR:+\"$VAR\"}${VAR:-null} one-liner pattern is broken when VAR IS set —
# ":-null" then returns $VAR itself (not "null"), producing duplicated
# output like "sess_x"sess_x instead of "sess_x". Use an explicit if instead.
if [ -n "$SESSION_ID" ]; then
  SESSION_ID_JSON="\"$SESSION_ID\""
else
  SESSION_ID_JSON="null"
fi

# Same null-quoting pattern for episode_id — will genuinely be empty for
# any current-ticket.json baseline set before this field existed, so this
# is expected, not an error.
if [ -n "$EPISODE_ID" ]; then
  EPISODE_ID_JSON="\"$EPISODE_ID\""
else
  EPISODE_ID_JSON="null"
fi

# Same null-quoting pattern for episode_started_at (2026-08-28) — will
# genuinely be empty for any baseline set before this field existed.
if [ -n "$EPISODE_STARTED_AT" ]; then
  EPISODE_STARTED_AT_JSON="\"$EPISODE_STARTED_AT\""
else
  EPISODE_STARTED_AT_JSON="null"
fi

# 4. Hand the trailer values to commit-msg — no intermediate JSON file.
# REMOVED 2026-08-27: this used to write a brand-new
# ".kiro-tracking/${TICKET_ID}-$(date +%s).json" file EVERY commit and
# `git add` it, so the folder accumulated one committed file per commit
# forever (35 of them by the time this was caught — see TODO.md). Grepped
# the whole repo first to confirm: commit-msg's `ls -t .kiro-tracking/*.json
# | head -1` was the ONLY reader anywhere. calculate-pr-credits.sh already
# reads trailers straight from git history, never these files. So the file
# was pure hop-across-hooks plumbing, not data anyone needed kept.
#
# pre-commit and commit-msg are separate git-invoked processes — a shell
# variable set here does not survive into commit-msg's process, so
# *something* has to carry these values across that boundary. This writes
# them as plain key=value lines into a file inside .git/ itself: never
# tracked, never committed, exactly one file, overwritten every commit.
# commit-msg sources it directly and deletes it right after reading.
GIT_DIR=$(git rev-parse --git-dir)
cat > "$GIT_DIR/KIRO_COMMIT_DATA" << INNER_EOF
KIRO_TICKET_ID="$TICKET_ID"
KIRO_TICKET_SOURCE="$SOURCE"
KIRO_SESSION_ID="$SESSION_ID"
KIRO_CREDITS_DELTA="$CREDITS_DELTA"
KIRO_CREDIT_CONFIDENCE="$CREDIT_CONFIDENCE"
KIRO_EPISODE_ID="$EPISODE_ID"
KIRO_EPISODE_STARTED_AT="$EPISODE_STARTED_AT"
KIRO_ELAPSED_MINUTES="$ELAPSED_MINUTES"
KIRO_ASK_CONFIRMED_GAP_SECONDS="$ASK_CONFIRMED_GAP_SECONDS"
KIRO_ASK_CONFIRMED="$ASK_CONFIRMED"
KIRO_JIRA_VALIDATION_STATUS="$JIRA_VALIDATION_STATUS"
KIRO_CLOUD_ID_CONFIRMED="$CLOUD_ID_CONFIRMED"
INNER_EOF

# 4b. Optional debug convenience copy — ONE file per ticket, overwritten
# every commit (not accumulated), so a human can glance at the last
# commit's numbers without decoding trailers. Gitignored — never
# `git add`-ed, and nothing (commit-msg included) reads it back; it's a
# side effect for a human, not a data source anything depends on.
mkdir -p .kiro-tracking
DEBUG_FILE=".kiro-tracking/${TICKET_ID}.json"
cat > "$DEBUG_FILE" << INNER_EOF
{
  "_comment": "Debug convenience only — overwritten every commit, not read by any hook or script. The real record is this commit's Kiro-* trailers.",
  "ticket_id": "$TICKET_ID",
  "source_of_ticket_id": "$SOURCE",
  "kiro_session_id": $SESSION_ID_JSON,
  "kiro_used": $([ -n "$SESSION_ID" ] && echo true || echo false),
  "credits_used_so_far": $CREDITS_DELTA,
  "credit_confidence": "$CREDIT_CONFIDENCE",
  "episode_id": $EPISODE_ID_JSON,
  "episode_started_at": $EPISODE_STARTED_AT_JSON,
  "elapsed_minutes": $ELAPSED_MINUTES,
  "dev": "$(git config user.email)",
  "branch": "$(git branch --show-current)",
  "commit_time": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
INNER_EOF

# 5. S3 upload removed 2026-08-25 — the AWS role is read-only, this line
# was failing every single commit (see hook-health.log's alternating
# ok/failed before this change). The commit message trailers (see
# commit-msg) are the durable, authoritative record — git push and
# reading commit messages back don't need any AWS write access at all.
# Health logging kept, unconditionally "ok" now — nothing here can fail
# once the S3 attempt is gone.
echo "hook_status=ok" >> .kiro-tracking/hook-health.log
